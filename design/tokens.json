{
  "meta": {
    "name": "mkvi-design-tokens",
    "version": "1.0.0",
    "note": "Single source of truth for the mkvi Flutter design system. This file is the only place a colour, size, radius or duration may be written down. design/tool/generate_tokens.dart turns it into design/generated/tokens.g.dart; design/test/contrast_test.dart fails the build if any pair in `contrast` is violated, if a theme is missing a role, or if the generated file drifts. The frozen React/Tauri UI in src/ reads nothing from here.",
    "consumedBy": [
      "design/tool/generate_tokens.dart (Dart source generation)",
      "design/test/contrast_test.dart (accessibility gate)"
    ],
    "defaultTheme": "midnight",
    "defaultAccent": "blue",
    "derivation": {
      "mixSpace": "srgb8",
      "mixNote": "Derived roles are produced with color-mix(in srgb) semantics: each 8-bit channel is interpolated independently and rounded half away from zero. The generator and the test share one implementation, so the numbers can never drift apart.",
      "amountRange": "0.0 - 1.0, fraction of the way from `seed` to `target`"
    },
    "rules": [
      "A theme MUST define every role in `roles`. A missing role is a build error, never a silent fallback to another theme.",
      "`accent` MUST differ from `focusRing`. A focus ring painted in the accent colour is invisible (measured 1.00:1 in the old UI).",
      "`stage` is always dark and `textOnStage` is always light, in every theme. Video and call surfaces never follow the theme polarity.",
      "`border` is a structural outline and clears 3:1 on every surface it can legally sit on. Do not reintroduce sub-3:1 hairlines for decoration; separate with elevation instead.",
      "Progress tracks, meters and unfilled control slots use `border`, never `surfaceSoft` (measured 1.24:1 in the old UI).",
      "Text on `accentSoft` uses `text`, never `textOnAccent`.",
      "Accent fills are capped at relative luminance 0.1833 so one near-white `textOnAccent` clears 4.5:1 on `accent`, `accentHover` and `accentActive` in all four themes.",
      "Interaction states on filled buttons also change elevation (shadow1 -> shadow2) because the accent lightness ramp is deliberately narrow: the ceiling above leaves only a small band above `accent` for `accentHover`.",
      "A filled accent control must sit on `bg` or `surface`. On `surfaceRaised` or `surfaceSoft` give it a `borderStrong` edge, because `accent` only clears 3:1 on the two base surfaces.",
      "Accent-coloured text is not allowed. Use `focusRing`, which is validated at 4.5:1 on every surface, or `text`.",
      "The stage never uses `text`; it uses `textOnStage`. `text` on a dark stage is unreadable in a light theme, which is exactly the 1.17:1 and 2.79:1 failure the old light theme shipped.",
      "Never lower a colour's opacity to express hierarchy. Use `text`, `textMuted`, `textSubtle` or size/weight instead (the old 4.47:1 timestamp came from a 60% white)."
    ],
    "roles": [
      "bg",
      "surface",
      "surfaceRaised",
      "surfaceSoft",
      "surfaceOverlay",
      "text",
      "textMuted",
      "textSubtle",
      "textOnAccent",
      "textOnStage",
      "stage",
      "border",
      "borderStrong",
      "accent",
      "accentHover",
      "accentActive",
      "accentSoft",
      "focusRing",
      "success",
      "successSoft",
      "warning",
      "warningSoft",
      "danger",
      "dangerFill",
      "dangerFillHover",
      "scrim",
      "shadow1",
      "shadow2",
      "shadow3"
    ],
    "roleNotes": {
      "bg": "Window background behind every panel.",
      "surface": "Default card, panel and list background. Text is measured against this.",
      "surfaceRaised": "Cards, popovers, menus and anything that must read as lifted.",
      "surfaceSoft": "Inset wells: input fields, hovered rows, code blocks, empty states.",
      "surfaceOverlay": "Top-most floating layer: command palette, dialog, tooltip.",
      "text": "Primary text and icons. 7:1 minimum everywhere.",
      "textMuted": "Secondary text, labels, helper copy.",
      "textSubtle": "Tertiary text: placeholders, timestamps, disabled controls. 4.5:1 floor.",
      "textOnAccent": "Text and icons on `accent`, `accentHover`, `accentActive`, `dangerFill`.",
      "textOnStage": "Text on the always-dark media/call stage.",
      "stage": "Video, screen-share and call surfaces. Always dark, in every theme.",
      "border": "Structural outline and separator. 3:1 on every surface.",
      "borderStrong": "Outline for controls that must be unmistakable: inputs, focusable rows.",
      "accent": "Primary action fill, selection, active nav marker.",
      "accentHover": "Primary action fill under the pointer.",
      "accentActive": "Primary action fill while pressed or selected.",
      "accentSoft": "Tinted background for selected rows, chips and badges. Text on it is `text`.",
      "focusRing": "Keyboard focus outline. Must differ from `accent` and clear 3:1 against it.",
      "success": "Positive status text and icon.",
      "successSoft": "Positive status background.",
      "warning": "Caution status text and icon.",
      "warningSoft": "Caution status background.",
      "danger": "Destructive text, icon and outline.",
      "dangerFill": "Destructive fill, e.g. hang up. Takes `textOnAccent`.",
      "dangerFillHover": "Destructive fill under the pointer.",
      "scrim": "Modal scrim laid over content.",
      "shadow1": "Elevation 1: resting cards, list rows.",
      "shadow2": "Elevation 2: hovered cards, raised controls, sticky bars.",
      "shadow3": "Elevation 3: popovers, menus, dialogs."
    },
    "sources": {
      "accent": { "kind": "accentKey", "key": "base" },
      "accentHover": { "kind": "accentKey", "key": "hover" },
      "accentActive": { "kind": "accentKey", "key": "active" },
      "textOnAccent": { "kind": "accentKey", "key": "on" },
      "focusRing": {
        "kind": "derived",
        "seed": { "kind": "accentRole", "role": "accent" },
        "target": { "kind": "themeKey", "key": "focusRingTarget" },
        "amount": { "kind": "themeKey", "key": "focusRingMix" }
      },
      "accentSoft": {
        "kind": "derived",
        "seed": { "kind": "accentRole", "role": "accent" },
        "target": { "kind": "themeRole", "role": "surface" },
        "amount": { "kind": "themeKey", "key": "accentSoftMix" }
      }
    }
  },

