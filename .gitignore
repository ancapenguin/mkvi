# --- Cloudflare Worker --------------------------------------------------------
# The ONLY npm project left in the repo, so this is the only `node_modules` rule.
# `cloudflare/package.json` keeps its own lockfile on purpose: its wrangler and
# typescript versions are chosen independently of everything else.
# NOTE: the retired 0.1.x line also ignored `dist/` and `dist-ssr/` (Vite output,
# consumed by Tauri as `frontendDist: ../dist`). No bundler runs at the root
# any more, so those rules are gone with it. Flutter output is `build/` below.
node_modules/
cloudflare/wrangler-login.*

# --- Release signing material -------------------------------------------------
# Never commit the private key or its password. Still required even though the
# Tauri updater plugin is gone: the feed schema (latest.json + minisign) is
# unchanged, only its client moved into Rust (mkvi_core::update).
*.key
*.key.pub
.secrets/
.release-assets/

# --- Flutter / Dart -----------------------------------------------------------
# pubspec.lock IS tracked on purpose: an application must ship reproducible
# dependency versions. (A library package would ignore it; MKVI is an app.)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.iml

# --- Avenox second brain -----------------------------------------------------
# Beyin KOD DEPOSUNUN DISINDA yasar: mkvi/ yanindaki mkvi-beyin/ klasorunde.
# Buraya tekrar kurulmamasi icin guvenlik agi: kendi dosyalari asla izlenmesin.
# (Beyin vault'ta kalir; calisma hafizasi ve kurallar proje kodundan ayridir.)
.beyin-version
.beyin-runtime.json
.beyin-state/
# 2026-09-26: `AGENTS.md` ve `CLAUDE.md` bu listeden CIKARILDI. Ikisi de
# projenin kilavuz dosyalari ve katilimcinin ilk okudugu sey. Once buradaydilar
# ve public depoya hic girmiyorlardi - dosya oradaydi ama kimse goremiyordu.
# `AGENTS.md` tek yazili kaynak; `CLAUDE.md` onun tureti ve
# `.\tool.ps1 docs` ile her kapida yeniden uretilir.
.agents/
daily/
notes/
knowledge/
beyin.py
# Companion klasorunun adi onekli bir emoji ile basliyor; glob ile yakalaniyor.
*Companion*/
Beyni Guncelle.cmd
Beyni Guncelle.sh
Beyni Guncelle.command
Beyni Guncelle.desktop

# Ajan calisma zamani artik bu depoda degil; kalinti dosyalar izlenmez.
#
# 2026-09-26: `CLAUDE.md` bu listeden CIKARILDI. Artik izleniyor, cunku
# `AGENTS.md`'nin tureti ve katilimcinin ilk okudugu dosya. Once buradaydi ve
# public depoya hic girmeyecekti - dosya oradaydi ama kimse goremeyecekti.
# `.\tool.ps1 docs` her kapida yeniden uretir, yani elle duzenlenmemeli.
.claude/
.codex/
.omp/
.opencode/plugins/
